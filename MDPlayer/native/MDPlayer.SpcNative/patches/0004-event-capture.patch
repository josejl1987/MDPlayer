+	// PR 11 instrumentation (MDPlayer): per-sample effective transition
+	// capture. The callback only receives values and never writes emulator
+	// state. `sample` is the output-sample offset of the current DSP sample.
+	typedef void (*event_capture_func)( void*, int sample, int type, int voice,
+		int param0, int param1 );
+	void set_event_capture( event_capture_func callback, void* user )
+	{
+		m.event_capture      = callback;
+		m.event_capture_user = user;
+		m.capture_sample     = 0;
+		bool initial_capture = !m.capture_initialized;
+		for ( int i = 0; i < voice_count; i++ )
+		{
+			int base = i * 0x10;
+			m.capture_keyed [i] = m.voices [i].enabled != 0 && m.voices [i].env > 0;
+			m.capture_mode [i] = m.voices [i].env_mode;
+			m.capture_source [i] = m.regs [base + v_srcn];
+			m.capture_pitch [i] = (m.regs [base + v_pitchl] |
+				((m.regs [base + v_pitchh] & 0x3F) << 8)) & 0x3FFF;
+			m.capture_volume_l [i] = m.regs [base + v_voll];
+			m.capture_volume_r [i] = m.regs [base + v_volr];
+			m.capture_flags [i] = ((m.regs [r_non]  >> i) & 1) |
+				(((m.regs [r_pmon] >> i) & 1) << 1) |
+				(((m.regs [r_eon]  >> i) & 1) << 2);
+		}
+		m.capture_initialized = 1;
+		if ( initial_capture )
+		{
+			for ( int i = 0; i < voice_count; i++ )
+			{
+				this->emit_event( 4, i, m.capture_source [i], m.capture_source [i] );
+				this->emit_event( 6, i, m.capture_volume_l [i], m.capture_volume_r [i] );
+				this->emit_event( 7, i, m.capture_flags [i] & 1, 0 );
+				this->emit_event( 8, i, (m.capture_flags [i] >> 1) & 1, 0 );
+				this->emit_event( 9, i, (m.capture_flags [i] >> 2) & 1, 0 );
+				this->emit_event( 10, i, m.capture_mode [i], m.voices [i].env );
+			}
+		}
+	}
+
+	void clear_event_capture()
+	{
+		m.event_capture = NULL;
+		m.event_capture_user = NULL;
+	}
+
+	void emit_event( int type, int voice, int param0, int param1 )
+	{
+		if ( m.event_capture )
+			m.event_capture( m.event_capture_user, m.capture_sample, type,
+				voice, param0, param1 );
+	}
