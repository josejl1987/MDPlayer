<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fmp.Application</RootNamespace>
    <!-- Allow running on machines with only a newer .NET runtime (e.g. .NET 10). -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <!-- The CLI and GUI consume the same application layer; tests too. -->
    <InternalsVisibleTo Include="mdplayer-render" />
    <InternalsVisibleTo Include="MDPlayer.Fmp.Tests" />
    <InternalsVisibleTo Include="MDPlayer.Fmp.Application.Tests" />
    <InternalsVisibleTo Include="MDPlayer.Fmp.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MDPlayer.Fmp.Core\MDPlayer.Fmp.Core.csproj" />
  </ItemGroup>

</Project>
