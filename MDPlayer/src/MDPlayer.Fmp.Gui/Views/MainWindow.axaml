<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fmp.Gui.ViewModels"
        xmlns:contracts="using:Fmp.Application.Contracts"
        xmlns:sys="using:System"
        x:Class="Fmp.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MDPlayer Visualizer"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="700"
        Background="{StaticResource Brush.Canvas}"
        Foreground="{StaticResource Brush.TextPrimary}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenInputCommand}"/>
    <KeyBinding Gesture="Ctrl+R" Command="{Binding RenderCommand}"/>
    <KeyBinding Gesture="F5" Command="{Binding RefreshPreviewCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCurrentCommand}"/>
    <KeyBinding Gesture="Left" Command="{Binding SeekRelativeCommand}" CommandParameter="-1"/>
    <KeyBinding Gesture="Right" Command="{Binding SeekRelativeCommand}" CommandParameter="1"/>
    <KeyBinding Gesture="Shift+Left" Command="{Binding SeekRelativeCommand}" CommandParameter="-10"/>
    <KeyBinding Gesture="Shift+Right" Command="{Binding SeekRelativeCommand}" CommandParameter="10"/>
    <KeyBinding Gesture="Home" Command="{Binding SeekStartCommand}"/>
    <KeyBinding Gesture="End" Command="{Binding SeekEndCommand}"/>
  </Window.KeyBindings>

  <Grid x:Name="MainLayout" RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!-- ── Top toolbar ─────────────────────────────────────────────── -->
    <Border x:Name="TopToolbar" Grid.Row="0" Classes="toolbar" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="MDPlayer" FontSize="14" FontWeight="Bold"
                     Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
          <Button x:Name="OpenInputButton" Classes="secondary" Content="Open Input"
                  Command="{Binding OpenInputCommand}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="RenderButton" Classes="primary" Content="Render"
                  Command="{Binding RenderCommand}" MinWidth="110" HorizontalContentAlignment="Center"/>
          <Button Classes="secondary" Content="Cancel" Command="{Binding CancelExportCommand}"
                  IsVisible="{Binding Export.IsRunning}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Export strip (progress / completed / failed) ────────────── -->
    <Border x:Name="ExportProgress" Grid.Row="1" IsVisible="{Binding Export.IsActive}" Classes="toolbar"
            BorderThickness="0,1,0,0" Padding="12,8">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Classes="secondary" Text="{Binding Export.StageAndProgressText}" VerticalAlignment="Center"
                     TextWrapping="Wrap" MaxWidth="420"/>
          <ProgressBar Value="{Binding Export.StageProgress, Mode=OneWay}" IsIndeterminate="{Binding Export.IsIndeterminate, Mode=OneWay}"
                       Minimum="0" Maximum="1" Width="180" VerticalAlignment="Center"/>
          <TextBlock Classes="metric" Text="{Binding Export.MetricsText}" VerticalAlignment="Center"/>
          <Button Classes="secondary" Content="Cancel" Command="{Binding CancelExportCommand}"
                  IsVisible="{Binding Export.IsRunning}"/>
        </StackPanel>

        <TextBlock IsVisible="{Binding Export.HasCompleted}" Classes="caption"
                   Text="{Binding Export.CompletionSummary}" TextWrapping="Wrap"/>
        <StackPanel IsVisible="{Binding Export.HasCompleted}" Orientation="Horizontal" Spacing="8">
          <Button Classes="secondary" Content="Open video" Command="{Binding OpenOutputCommand}"/>
          <Button Classes="secondary" Content="Open folder" Command="{Binding OpenOutputFolderCommand}"/>
        </StackPanel>
        <StackPanel IsVisible="{Binding Export.HasFailed}" Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="caption" Text="{Binding Export.FailureSummary}"
                     Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" MaxWidth="480"
                     VerticalAlignment="Center"/>
          <Button Classes="secondary" Content="Retry" Command="{Binding Export.RetryCommand}"/>
          <Button Classes="secondary" Content="Copy details" Command="{Binding CopyErrorCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ── Main area: settings | preview+transport ─────────────────── -->
    <Grid x:Name="MainContent" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"
                          MinWidth="280"
                          MaxWidth="400"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: settings sections -->
      <Grid x:Name="SettingsSidebar" Grid.Column="0" IsEnabled="{Binding CanEdit}">
        <ScrollViewer>
          <StackPanel Margin="12" Spacing="10">

            <!-- INPUT -->
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-title" Text="INPUT"/>
                <TextBlock Text="{Binding InputTitle}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Classes="metric" Text="{Binding InputSummary}" TextWrapping="Wrap"/>
                <Button Classes="secondary" Content="Change input…" Command="{Binding OpenInputCommand}"
                        HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>

            <!-- COMPOSITION -->
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-title" Text="COMPOSITION"/>
                <ComboBox x:Name="CompositionSelector" Classes="compact"
                          ItemsSource="{Binding Settings.Basic.Compositions}"
                          SelectedItem="{Binding Settings.Basic.SelectedComposition}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CompositionOptionViewModel">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Classes="caption" Text="{Binding Description}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <!-- TRACKS -->
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-title" Text="TRACKS"/>
                <ComboBox x:Name="TrackModeSelector" Classes="compact"
                          ItemsSource="{Binding Settings.Content.TrackSelectionOptions}"
                          SelectedItem="{Binding Settings.Content.SelectedTrackSelection}"/>
                <CheckBox Classes="compact" Content="Include inactive diagnostic tracks"
                          IsChecked="{Binding Settings.Content.IncludeInactiveDiagnostics}"/>
                <ItemsControl x:Name="TrackList" ItemsSource="{Binding Settings.Content.Tracks}" MaxHeight="220">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackItemViewModel">
                      <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                        <Ellipse Grid.Column="1" Width="8" Height="8" Margin="6,0,6,0" VerticalAlignment="Center"
                                 Fill="{Binding ColorBrush}"/>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="caption" Text="{Binding DeviceFamily}"/>
                            <TextBlock Classes="caption" Text="{Binding SemanticType}"/>
                            <TextBlock Classes="caption" Text="scope" IsVisible="{Binding ScopeAvailable}"/>
                            <TextBlock Classes="caption" Text="activity" IsVisible="{Binding ActivityDetected}"/>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- PLAYBACK -->
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-title" Text="PLAYBACK"/>
                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="caption" Grid.Column="0" Text="Loops" VerticalAlignment="Center"/>
                  <NumericUpDown Classes="compact" Grid.Column="1" VerticalAlignment="Center"
                                 Value="{Binding Settings.Advanced.LoopCount}" Minimum="1" Maximum="99"
                                 Increment="1" FormatString="0"/>
                  <TextBlock Classes="caption" Grid.Column="2" Text="Fade s" VerticalAlignment="Center"/>
                  <NumericUpDown Classes="compact" Grid.Column="3" VerticalAlignment="Center"
                                 Value="{Binding Settings.Advanced.FadeSeconds}" Minimum="0" Maximum="60"
                                 Increment="0.5" FormatString="0.0"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="caption" Grid.Column="0" Text="Tail s" VerticalAlignment="Center"/>
                  <NumericUpDown Classes="compact" Grid.Column="1" VerticalAlignment="Center"
                                 Value="{Binding Settings.Advanced.TailSeconds}" Minimum="0" Maximum="60"
                                 Increment="0.1" FormatString="0.0"/>
                  <TextBlock Classes="caption" Grid.Column="2" Text="Max s" VerticalAlignment="Center"/>
                  <NumericUpDown Classes="compact" Grid.Column="3" VerticalAlignment="Center"
                                 Value="{Binding Settings.Advanced.MaximumDurationSeconds}" Minimum="1"
                                 Maximum="86400" Increment="10" FormatString="0"/>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="caption" Grid.Column="0" Text="Sample rate" VerticalAlignment="Center"/>
                  <NumericUpDown Classes="compact" Grid.Column="1" VerticalAlignment="Center"
                                 Value="{Binding Settings.Advanced.SampleRate}" Minimum="8000" Maximum="192000"
                                 Increment="1000" FormatString="0"/>
                </Grid>
                <StackPanel IsVisible="{Binding Settings.Advanced.ShowSsgGain}" Spacing="4">
                  <TextBlock Classes="caption" Text="SSG gain (dB)"/>
                  <NumericUpDown Classes="compact" Value="{Binding Settings.Advanced.SsgGainDb}"
                                 Minimum="-60" Maximum="12" Increment="0.5" FormatString="0.0"/>
                  <TextBlock Classes="caption" Text="{Binding Settings.Advanced.SsgGainNote}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel IsVisible="{Binding Settings.Advanced.ShowSpcPitch}" Spacing="4">
                  <TextBlock Classes="caption" Text="SPC pitch interpretation"/>
                  <ComboBox Classes="compact" ItemsSource="{Binding Settings.Advanced.SpcPitchOptions}"
                            SelectedItem="{Binding Settings.Advanced.SelectedSpcPitch}"/>
                  <TextBlock Classes="caption" Text="{Binding Settings.Advanced.SpcPitchNote}" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- STYLE -->
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-title" Text="STYLE"/>
                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                  <TextBlock Classes="caption" Grid.Column="0" Text="Past" VerticalAlignment="Center"/>
                  <NumericUpDown Classes="compact" Grid.Column="1" VerticalAlignment="Center"
                                 Value="{Binding Settings.Style.PastSeconds}" Minimum="0.1" Maximum="15"
                                 Increment="0.1" FormatString="0.0"/>
                  <TextBlock Classes="caption" Grid.Column="2" Text="Future" VerticalAlignment="Center"/>
                  <NumericUpDown Classes="compact" Grid.Column="3" VerticalAlignment="Center"
                                 Value="{Binding Settings.Style.FutureSeconds}" Minimum="0.1" Maximum="15"
                                 Increment="0.1" FormatString="0.0"/>
                </Grid>
                <ComboBox Classes="compact" ItemsSource="{Binding Settings.Style.EffectsOptions}"
                          SelectedItem="{Binding Settings.Style.SelectedEffects}"/>
                <ComboBox Classes="compact" ItemsSource="{Binding Settings.Style.NoteColorOptions}"
                          SelectedItem="{Binding Settings.Style.SelectedNoteColor}"/>
                <ComboBox Classes="compact" ItemsSource="{Binding Settings.Style.PaletteOptions}"
                          SelectedItem="{Binding Settings.Style.SelectedPalette}"/>
              </StackPanel>
            </Border>

            <!-- TITLE & CREDITS -->
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-title" Text="TITLE &amp; CREDITS"/>
                <TextBox Classes="compact" Watermark="Title" Text="{Binding Settings.Metadata.Title}"/>
                <TextBox Classes="compact" Watermark="Subtitle" Text="{Binding Settings.Metadata.Subtitle}"/>
                <TextBox Classes="compact" Watermark="Credits" Text="{Binding Settings.Metadata.Credits}"/>
                <Button Classes="secondary" Content="Restore detected metadata"
                        Command="{Binding Settings.Metadata.RestoreDetectedCommand}" HorizontalAlignment="Left"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Classes="compact" Grid.Column="0" Watermark="Font path" Text="{Binding Settings.Metadata.FontPath}"/>
                  <Button Grid.Column="1" Classes="secondary" Content="Browse…"
                          Command="{Binding Settings.Metadata.BrowseFontCommand}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- OUTPUT -->
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Classes="section-title" Text="OUTPUT"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox x:Name="OutputPathBox" Classes="compact" Grid.Column="0" Text="{Binding OutputPath}" IsReadOnly="True"
                           ToolTip.Tip="{Binding OutputPath}"/>
                  <Button Grid.Column="1" Classes="secondary" Content="Browse…"
                          Command="{Binding ChooseOutputPathCommand}"/>
                </Grid>
                <CheckBox Content="Overwrite existing output"
                          IsChecked="{Binding Settings.Advanced.Overwrite}"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <ComboBox Classes="compact" Grid.Column="0"
                            ItemsSource="{Binding Settings.Advanced.EncoderOptions}"
                            SelectedItem="{Binding Settings.Advanced.SelectedEncoder}"/>
                  <ComboBox Classes="compact" Grid.Column="1"
                            ItemsSource="{Binding Settings.Basic.QualityOptions}"
                            SelectedItem="{Binding Settings.Basic.SelectedQuality}"/>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <ComboBox Classes="compact" Grid.Column="0"
                            ItemsSource="{Binding Settings.Basic.FpsOptions}"
                            SelectedItem="{Binding Settings.Basic.SelectedFps}"/>
                  <ComboBox Classes="compact" Grid.Column="1"
                            ItemsSource="{Binding Settings.Basic.ResolutionOptions}"
                            SelectedItem="{Binding Settings.Basic.SelectedResolution}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Settings.Basic.IsCustomResolution}">
                  <NumericUpDown Classes="compact" Value="{Binding Settings.Basic.CustomWidth}"
                                 Minimum="480" Maximum="7680" Increment="160"/>
                  <TextBlock Text="×" VerticalAlignment="Center"/>
                  <NumericUpDown Classes="compact" Value="{Binding Settings.Basic.CustomHeight}"
                                 Minimum="270" Maximum="4320" Increment="90"/>
                </StackPanel>
                <TextBlock Classes="caption" Text="{Binding OutputStatusText}" TextWrapping="Wrap"/>
                <Button Classes="primary" Content="Render" Command="{Binding RenderCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Grid>

      <GridSplitter x:Name="MainSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                    Background="{StaticResource Brush.Canvas}"/>

      <!-- Center: studio preview frame + attached transport -->
      <Grid x:Name="PreviewPanel" Grid.Column="2" Margin="0,12,12,12">
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- Preview header -->
          <Border Grid.Row="0" Classes="toolbar" CornerRadius="6,6,0,0" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Preview" FontWeight="SemiBold"/>
                <Border CornerRadius="9" Background="{StaticResource Brush.AccentSoft}" Padding="8,2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="Accurate" FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="timecode" Text="{Binding TimeText}" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- Preview viewport -->
          <Border x:Name="PreviewViewport" Grid.Row="1" Classes="preview"
                  BorderThickness="1,0,1,0" CornerRadius="0">
            <Panel>
              <Image Source="{Binding Preview.CurrentImage}" Stretch="Uniform"/>

              <StackPanel x:Name="EmptyState" IsVisible="{Binding !Preview.HasImage}" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Open a music file" HorizontalAlignment="Center"
                           FontSize="22" FontWeight="SemiBold"/>
                <Button Classes="primary" Content="Open input" Command="{Binding OpenInputCommand}"
                        HorizontalAlignment="Center" MinWidth="130"/>
                <TextBlock Classes="caption" Text="VGM · VGZ · SPC · MIDI · S98 · FMP"
                           HorizontalAlignment="Center"/>
                <StackPanel IsVisible="{Binding HasRecentFiles}" Spacing="4" Margin="0,8,0,0">
                  <TextBlock Classes="caption" Text="Recent" HorizontalAlignment="Center"/>
                  <ItemsControl ItemsSource="{Binding RecentFiles}" MaxHeight="140">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RecentFileItemViewModel">
                        <Button Classes="secondary" Command="{Binding OpenCommand}"
                                HorizontalContentAlignment="Left" MinWidth="260">
                          <TextBlock Text="{Binding DisplayName}"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <Panel IsVisible="{Binding Preview.IsLoading}" IsHitTestVisible="False"
                     Background="{StaticResource Brush.LoadingSurface}">
                <Border Background="{StaticResource Brush.Surface2}" CornerRadius="6" Padding="16,12"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="6" VerticalAlignment="Center"/>
                    <TextBlock Classes="caption" Text="Rendering frame…" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Panel>

              <Border IsVisible="{Binding Preview.HasError}" Background="{StaticResource Brush.ErrorSurface}"
                      BorderBrush="{StaticResource Brush.Error}" BorderThickness="1" CornerRadius="6"
                      Padding="10,6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Preview.ErrorText}" FontSize="11" TextWrapping="Wrap"
                             MaxWidth="340" VerticalAlignment="Center"
                             Foreground="{StaticResource Brush.Error}"/>
                  <Button Classes="secondary" Content="Retry" Command="{Binding Preview.RetryCommand}"
                          VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Panel>
          </Border>

          <!-- Transport (attached to the viewport) -->
          <Border x:Name="TimelineTransport" Grid.Row="2" Classes="toolbar"
                  BorderThickness="1,1,1,0" CornerRadius="0,0,6,6" Padding="12,8"
                  IsEnabled="{Binding HasInput}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
              <Button Grid.Column="0" Classes="icon" Content="◀" Command="{Binding PreviousPointCommand}"
                      ToolTip.Tip="Previous representative point"/>
              <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{StaticResource Brush.Accent}"
                       VerticalAlignment="Center" ToolTip.Tip="Current position"/>
              <Slider x:Name="PreviewSlider" Grid.Column="2" Classes="transport" Minimum="0"
                      Maximum="{Binding DurationSeconds}" Value="{Binding PreviewScrubTime}"
                      PointerReleased="OnPreviewSliderReleased"
                      KeyUp="OnPreviewSliderKeyUp"/>
              <Button Grid.Column="3" Classes="icon" Content="▶" Command="{Binding NextPointCommand}"
                      ToolTip.Tip="Next representative point"/>
              <TextBlock Grid.Column="4" Classes="timecode" Text="{Binding TimeText}"
                         VerticalAlignment="Center" MinWidth="100" TextAlignment="Right"/>
            </Grid>
          </Border>

        </Grid>
      </Grid>
    </Grid>

    <!-- ── Bottom status: error + status ───────────────────────────── -->
    <Border x:Name="StatusBar" Grid.Row="3" Classes="status" Padding="12,5">
      <Grid ColumnDefinitions="*,Auto,2*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"/>

        <Border Grid.Column="1" IsVisible="{Binding HasError}" Background="{StaticResource Brush.ErrorSurface}"
                BorderBrush="{StaticResource Brush.Error}" BorderThickness="1" CornerRadius="4" Padding="10,4">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       VerticalAlignment="Center" FontSize="11" MaxWidth="360"
                       Foreground="{StaticResource Brush.Error}"/>
            <Button Grid.Column="1" Classes="secondary" Content="Copy details"
                    Command="{Binding CopyErrorCommand}" VerticalAlignment="Center" FontSize="11"/>
          </Grid>
        </Border>

        <TextBlock Grid.Column="2" Classes="caption" Text="{Binding OutputStatusText}"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" IsVisible="{Binding Export.HasCompleted}">
          <Button Classes="secondary" Content="Open video" Command="{Binding OpenOutputCommand}"/>
          <Button Classes="secondary" Content="Open folder" Command="{Binding OpenOutputFolderCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Validation issues (why Render may be disabled) ────────────── -->
    <Border Grid.Row="4" IsVisible="{Binding HasValidationIssues}" Classes="status" Padding="12,5">
      <ItemsControl ItemsSource="{Binding ValidationIssues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="contracts:ValidationIssue">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
              <TextBlock Text="{Binding Severity}" FontSize="11"
                         Classes="secondary"/>
              <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

  </Grid>
</Window>
