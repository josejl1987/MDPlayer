<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fmp.Gui.ViewModels"
        xmlns:contracts="using:Fmp.Application.Contracts"
        xmlns:sys="using:System"
        xmlns:local="using:Fmp.Gui.Views"
        x:Class="Fmp.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MDPlayer Visualizer"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="700"
        Background="{StaticResource Brush.Canvas}"
        Foreground="{StaticResource Brush.TextPrimary}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenInputCommand}"/>
    <KeyBinding Gesture="Ctrl+R" Command="{Binding RenderCommand}"/>
    <KeyBinding Gesture="F5" Command="{Binding RefreshPreviewCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCurrentCommand}"/>
    <KeyBinding Gesture="Left" Command="{Binding SeekRelativeCommand}" CommandParameter="-1"/>
    <KeyBinding Gesture="Right" Command="{Binding SeekRelativeCommand}" CommandParameter="1"/>
    <KeyBinding Gesture="Shift+Left" Command="{Binding SeekRelativeCommand}" CommandParameter="-10"/>
    <KeyBinding Gesture="Shift+Right" Command="{Binding SeekRelativeCommand}" CommandParameter="10"/>
    <KeyBinding Gesture="Home" Command="{Binding SeekStartCommand}"/>
    <KeyBinding Gesture="End" Command="{Binding SeekEndCommand}"/>
  </Window.KeyBindings>

  <Grid x:Name="MainLayout" RowDefinitions="48,Auto,*,36,Auto">

    <!-- ── Top toolbar ─────────────────────────────────────────────── -->
    <Border x:Name="TopToolbar" Grid.Row="0" Classes="toolbar" Padding="12,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="MDPlayer" FontSize="14" FontWeight="Bold"
                     Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
          <Button x:Name="OpenInputButton" Classes="secondary" Content="Open Input"
                  Command="{Binding OpenInputCommand}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                    IsVisible="{Binding HasInput}">
          <TextBlock Text="{Binding InputTitle}" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="RenderButton" Classes="primary" Content="Render"
                  Command="{Binding RenderCommand}" MinWidth="110" HorizontalContentAlignment="Center"/>
          <Button Classes="secondary" Content="Cancel" Command="{Binding CancelExportCommand}"
                  IsVisible="{Binding Export.IsRunning}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Export strip (progress / completed / failed) ────────────── -->
    <Border x:Name="ExportProgress" Grid.Row="1" IsVisible="{Binding Export.IsActive}" Classes="toolbar"
            BorderThickness="0,1,0,0" Padding="12,8">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Classes="secondary" Text="{Binding Export.StageAndProgressText}" VerticalAlignment="Center"
                     TextWrapping="Wrap" MaxWidth="420"/>
          <ProgressBar Value="{Binding Export.StageProgress, Mode=OneWay}" IsIndeterminate="{Binding Export.IsIndeterminate, Mode=OneWay}"
                       Minimum="0" Maximum="1" Width="180" VerticalAlignment="Center"/>
          <TextBlock Classes="metric" Text="{Binding Export.MetricsText}" VerticalAlignment="Center"/>
          <Button Classes="secondary" Content="Cancel" Command="{Binding CancelExportCommand}"
                  IsVisible="{Binding Export.IsRunning}"/>
        </StackPanel>

        <TextBlock IsVisible="{Binding Export.HasCompleted}" Classes="caption"
                   Text="{Binding Export.CompletionSummary}" TextWrapping="Wrap"/>
        <StackPanel IsVisible="{Binding Export.HasCompleted}" Orientation="Horizontal" Spacing="8">
          <Button Classes="secondary" Content="Open video" Command="{Binding OpenOutputCommand}"/>
          <Button Classes="secondary" Content="Open folder" Command="{Binding OpenOutputFolderCommand}"/>
        </StackPanel>
        <StackPanel IsVisible="{Binding Export.HasFailed}" Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="caption" Text="{Binding Export.FailureSummary}"
                     Foreground="{StaticResource Brush.Error}" TextWrapping="Wrap" MaxWidth="480"
                     VerticalAlignment="Center"/>
          <Button Classes="secondary" Content="Retry" Command="{Binding Export.RetryCommand}"/>
          <Button Classes="secondary" Content="Copy details" Command="{Binding CopyErrorCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ── Main area: settings | preview+transport | diagnostics ────── -->
    <Grid x:Name="MainContent" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>

      <!-- Left: settings sections -->
      <Grid x:Name="SettingsSidebar" Grid.Column="0" IsEnabled="{Binding CanEdit}">
        <ScrollViewer x:Name="SettingsScroll">
          <StackPanel x:Name="SidebarScrollContent" Margin="12,12,12,20" Spacing="6">

            <!-- INPUT -->
            <StackPanel Spacing="6">
              <TextBlock Classes="section-title" Text="INPUT"/>
              <TextBlock Text="{Binding InputTitle}" FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Classes="metric" Text="{Binding InputSummary}" TextWrapping="Wrap"/>
              <Button Classes="secondary" Content="Change input…" Command="{Binding OpenInputCommand}"
                      HorizontalAlignment="Left" IsVisible="{Binding HasInput}"/>
            </StackPanel>

            <Border Classes="separator"/>

            <!-- COMPOSITION -->
            <StackPanel Spacing="6">
              <TextBlock Classes="section-title" Text="COMPOSITION"/>
              <ComboBox x:Name="CompositionSelector" Classes="compact"
                        ItemsSource="{Binding Settings.Basic.Compositions}"
                        SelectedItem="{Binding Settings.Basic.SelectedComposition}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CompositionOptionViewModel">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Classes="caption" Text="{Binding Description}"/>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <Border Classes="separator"/>

            <!-- TRACKS -->
            <StackPanel Spacing="6">
              <TextBlock Classes="section-title" Text="TRACKS"/>
              <ComboBox x:Name="TrackModeSelector" Classes="compact"
                        ItemsSource="{Binding Settings.Content.TrackSelectionOptions}"
                        SelectedItem="{Binding Settings.Content.SelectedTrackSelection}"/>
              <CheckBox Classes="compact" Content="Include inactive diagnostic tracks"
                        IsChecked="{Binding Settings.Content.IncludeInactiveDiagnostics}"/>
              <ItemsControl x:Name="TrackList" ItemsSource="{Binding Settings.Content.Tracks}" MaxHeight="220">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrackItemViewModel">
                    <Grid ColumnDefinitions="Auto,3,8,*" MinHeight="42" Margin="0,0,0,0">
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Width="3" HorizontalAlignment="Left"
                              VerticalAlignment="Center" CornerRadius="1"
                              Background="{Binding ColorBrush}"/>
                      <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="6,0,0,0" Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="caption" Text="{Binding DeviceFamily}"/>
                          <TextBlock Classes="caption" Text="·"/>
                          <TextBlock Classes="caption" Text="{Binding SemanticType}"/>
                          <TextBlock Classes="caption" Text="·" IsVisible="{Binding ScopeAvailable}"/>
                          <TextBlock Classes="caption" Text="scope" IsVisible="{Binding ScopeAvailable}"/>
                          <TextBlock Classes="caption" Text="·" IsVisible="{Binding ActivityDetected}"/>
                          <TextBlock Classes="caption" Text="activity" IsVisible="{Binding ActivityDetected}"/>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border Classes="separator"/>

            <!-- PLAYBACK -->
            <StackPanel Spacing="6">
              <TextBlock Classes="section-title" Text="PLAYBACK"/>
              <Grid ColumnDefinitions="96,*" ColumnSpacing="12" RowSpacing="8"
                    RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Loops"
                           VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="compact"
                               Value="{Binding Settings.Advanced.LoopCount}" Minimum="1" Maximum="99"
                               Increment="1" FormatString="0"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Fade"
                           VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="compact"
                               Value="{Binding Settings.Advanced.FadeSeconds}" Minimum="0" Maximum="60"
                               Increment="0.5" FormatString="0.0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="Tail"
                           VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="compact"
                               Value="{Binding Settings.Advanced.TailSeconds}" Minimum="0" Maximum="60"
                               Increment="0.1" FormatString="0.0"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="field-label" Text="Max duration"
                           VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="3" Grid.Column="1" Classes="compact"
                               Value="{Binding Settings.Advanced.MaximumDurationSeconds}" Minimum="1"
                               Maximum="86400" Increment="10" FormatString="0"/>
              </Grid>
              <Grid ColumnDefinitions="96,*" ColumnSpacing="12" RowSpacing="8"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Sample rate"
                           VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="compact"
                               Value="{Binding Settings.Advanced.SampleRate}" Minimum="8000" Maximum="192000"
                               Increment="1000" FormatString="0"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="SSG gain (dB)"
                           VerticalAlignment="Center" IsVisible="{Binding Settings.Advanced.ShowSsgGain}"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="compact"
                               IsVisible="{Binding Settings.Advanced.ShowSsgGain}"
                               Value="{Binding Settings.Advanced.SsgGainDb}"
                               Minimum="-60" Maximum="12" Increment="0.5" FormatString="0.0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Classes="caption"
                           Text="{Binding Settings.Advanced.SsgGainNote}" TextWrapping="Wrap"
                           IsVisible="{Binding Settings.Advanced.ShowSsgGain}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="field-label" Text="SPC pitch"
                           VerticalAlignment="Center" IsVisible="{Binding Settings.Advanced.ShowSpcPitch}"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Classes="compact"
                          IsVisible="{Binding Settings.Advanced.ShowSpcPitch}"
                          ItemsSource="{Binding Settings.Advanced.SpcPitchOptions}"
                          SelectedItem="{Binding Settings.Advanced.SelectedSpcPitch}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Classes="field-label" Text="YM2608 audio"
                           VerticalAlignment="Center" IsVisible="{Binding Settings.Advanced.ShowOpnaBackend}"/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="OpnaBackendSelector" Classes="compact"
                          IsVisible="{Binding Settings.Advanced.ShowOpnaBackend}"
                          AutomationProperties.Name="YM2608 audio backend"
                          ToolTip.Tip="Audio backend used to render FMP YM2608 (OPNA) audio."
                          ItemsSource="{Binding Settings.Advanced.OpnaBackendOptions}"
                          SelectedIndex="{Binding Settings.Advanced.SelectedOpnaBackendIndex}"/>
              </Grid>
            </StackPanel>

            <Border Classes="separator"/>

            <!-- STYLE -->
            <StackPanel Spacing="6">
              <TextBlock Classes="section-title" Text="STYLE"/>
              <Grid ColumnDefinitions="96,*" ColumnSpacing="12" RowSpacing="8"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Past"
                           VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="compact"
                               Value="{Binding Settings.Style.PastSeconds}" Minimum="0.1" Maximum="15"
                               Increment="0.1" FormatString="0.0"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Future"
                           VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="compact"
                               Value="{Binding Settings.Style.FutureSeconds}" Minimum="0.1" Maximum="15"
                               Increment="0.1" FormatString="0.0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="Effects"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Classes="compact"
                          ItemsSource="{Binding Settings.Style.EffectsOptions}"
                          SelectedItem="{Binding Settings.Style.SelectedEffects}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="field-label" Text="Note colors"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Classes="compact"
                          ItemsSource="{Binding Settings.Style.NoteColorOptions}"
                          SelectedItem="{Binding Settings.Style.SelectedNoteColor}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Classes="field-label" Text="Palette"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Classes="compact"
                          ItemsSource="{Binding Settings.Style.PaletteOptions}"
                          SelectedItem="{Binding Settings.Style.SelectedPalette}"/>
              </Grid>
            </StackPanel>

            <Border Classes="separator"/>

            <!-- TITLE & CREDITS -->
            <StackPanel Spacing="6">
              <TextBlock Classes="section-title" Text="TITLE &amp; CREDITS"/>
              <Grid ColumnDefinitions="96,*" ColumnSpacing="12" RowSpacing="8"
                    RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Title"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Classes="compact" Watermark="Title"
                         Text="{Binding Settings.Metadata.Title}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Subtitle"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Classes="compact" Watermark="Subtitle"
                         Text="{Binding Settings.Metadata.Subtitle}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="Credits"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Classes="compact" Watermark="Credits"
                         Text="{Binding Settings.Metadata.Credits}"/>
              </Grid>
              <Button Classes="secondary" Content="Restore detected metadata"
                      Command="{Binding Settings.Metadata.RestoreDetectedCommand}" HorizontalAlignment="Left"/>
              <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Classes="field-label" Text="Font path"
                           VerticalAlignment="Center"/>
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Classes="compact" Grid.Column="0" Watermark="Font path"
                           Text="{Binding Settings.Metadata.FontPath}"/>
                  <Button Grid.Column="1" Classes="secondary" Content="Browse…"
                          Command="{Binding Settings.Metadata.BrowseFontCommand}"/>
                </Grid>
              </Grid>
            </StackPanel>

            <Border Classes="separator"/>

            <!-- OUTPUT -->
            <StackPanel x:Name="SidebarLastSection" Spacing="6">
              <TextBlock Classes="section-title" Text="OUTPUT"/>
              <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Classes="field-label" Text="Output path"
                           VerticalAlignment="Center"/>
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox x:Name="OutputPathBox" Classes="compact" Grid.Column="0" Text="{Binding OutputPath}"
                           IsReadOnly="True" ToolTip.Tip="{Binding OutputPath}"/>
                  <Button Grid.Column="1" Classes="secondary" Content="Browse…"
                          Command="{Binding ChooseOutputPathCommand}"/>
                </Grid>
              </Grid>
              <CheckBox Content="Overwrite existing output"
                        IsChecked="{Binding Settings.Advanced.Overwrite}"/>
              <Grid ColumnDefinitions="96,*" ColumnSpacing="12" RowSpacing="8"
                    RowDefinitions="Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Encoder"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Classes="compact"
                          ItemsSource="{Binding Settings.Advanced.EncoderOptions}"
                          SelectedItem="{Binding Settings.Advanced.SelectedEncoder}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Quality"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Classes="compact"
                          ItemsSource="{Binding Settings.Basic.QualityOptions}"
                          SelectedItem="{Binding Settings.Basic.SelectedQuality}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="Frame rate"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Classes="compact"
                          ItemsSource="{Binding Settings.Basic.FpsOptions}"
                          SelectedItem="{Binding Settings.Basic.SelectedFps}"/>
              </Grid>
              <Grid ColumnDefinitions="96,*" ColumnSpacing="12" RowSpacing="8"
                    RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Resolution"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Classes="compact"
                          ItemsSource="{Binding Settings.Basic.ResolutionOptions}"
                          SelectedItem="{Binding Settings.Basic.SelectedResolution}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Custom W × H"
                           VerticalAlignment="Center" IsVisible="{Binding Settings.Basic.IsCustomResolution}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding Settings.Basic.IsCustomResolution}">
                  <NumericUpDown Classes="compact" Width="150" Value="{Binding Settings.Basic.CustomWidth}"
                                 Minimum="480" Maximum="7680" Increment="160"/>
                  <TextBlock Text="×" VerticalAlignment="Center"/>
                  <NumericUpDown Classes="compact" Width="150" Value="{Binding Settings.Basic.CustomHeight}"
                                 Minimum="270" Maximum="4320" Increment="90"/>
                </StackPanel>
              </Grid>
              <TextBlock Classes="caption" Text="{Binding OutputStatusText}" TextWrapping="Wrap"/>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Grid>

      <GridSplitter x:Name="MainSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                    Background="{StaticResource Brush.Canvas}"/>

      <!-- Center: studio preview frame + attached transport -->
      <Grid x:Name="PreviewPanel" Grid.Column="2" Margin="0,12,12,12">
        <Grid RowDefinitions="40,*,44">

          <!-- Preview header -->
          <Border Grid.Row="0" Classes="toolbar" CornerRadius="6,6,0,0" Padding="12,0">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="10"
                          VerticalAlignment="Center">
                <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="14"/>
                <Border CornerRadius="9" Background="{StaticResource Brush.AccentSoft}" Padding="8,2">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Preview.BadgeText}" FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Compact-mode fallback: opens the shared diagnostics rail as a flyout -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                          VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button Classes="secondary" Content="Accurate frame"
                        Command="{Binding RenderAccuratePreviewCommand}"
                        IsEnabled="{Binding !IsAccuratePreviewRunning}"/>
                <Button x:Name="DiagnosticsToggleButton" Classes="secondary"
                        Content="Diagnostics">
                  <Button.Flyout>
                    <Flyout Placement="Bottom" ShowMode="Standard">
                      <local:DiagnosticsPanel Width="300" MinWidth="300" MaxWidth="360" Height="440"/>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Preview viewport -->
          <Border x:Name="PreviewViewport" Grid.Row="1" Classes="preview"
                  BorderThickness="1,0,1,0" CornerRadius="0">
            <Panel>
              <Image Source="{Binding Preview.CurrentImage}" Stretch="Uniform"/>

              <StackPanel x:Name="EmptyState" IsVisible="{Binding !Preview.HasImage}" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="Open a music file" HorizontalAlignment="Center"
                           FontSize="22" FontWeight="SemiBold"/>
                <Button Classes="primary" Content="Open input" Command="{Binding OpenInputCommand}"
                        HorizontalAlignment="Center" MinWidth="130"/>
                <TextBlock Classes="caption" Text="VGM · VGZ · SPC · MIDI · S98 · FMP"
                           HorizontalAlignment="Center"/>
                <StackPanel IsVisible="{Binding HasRecentFiles}" Spacing="4" Margin="0,8,0,0">
                  <TextBlock Classes="caption" Text="Recent" HorizontalAlignment="Center"/>
                  <ItemsControl ItemsSource="{Binding RecentFiles}" MaxHeight="150">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RecentFileItemViewModel">
                        <Button Classes="recent" Command="{Binding OpenCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            <TextBlock Classes="caption" Text="{Binding ParentDirectory}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <Panel IsVisible="{Binding Preview.IsLoading}" IsHitTestVisible="False"
                     Background="{StaticResource Brush.LoadingSurface}">
                <Border Background="{StaticResource Brush.Surface2}" CornerRadius="6" Padding="16,12"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="6" VerticalAlignment="Center"/>
                    <TextBlock Classes="caption" Text="{Binding Preview.LoadingText}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Panel>

              <!-- Non-blocking refinement warning (first frame remains visible) -->
              <Border IsVisible="{Binding Preview.HasWarning}" Background="{StaticResource Brush.Surface}"
                      BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1" CornerRadius="6"
                      Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
                <TextBlock Text="{Binding Preview.WarningText}" FontSize="11" TextWrapping="Wrap"
                           MaxWidth="640" Foreground="{StaticResource Brush.TextPrimary}"/>
              </Border>

              <Border IsVisible="{Binding Preview.HasError}" Background="{StaticResource Brush.ErrorSurface}"
                      BorderBrush="{StaticResource Brush.Error}" BorderThickness="1" CornerRadius="6"
                      Padding="10,6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Preview.ErrorText}" FontSize="11" TextWrapping="Wrap"
                             MaxWidth="340" VerticalAlignment="Center"
                             Foreground="{StaticResource Brush.Error}"/>
                  <Button Classes="secondary" Content="Retry" Command="{Binding Preview.RetryCommand}"
                          VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </Panel>
          </Border>

          <!-- Transport (attached to the viewport) -->
          <Border x:Name="TimelineTransport" Grid.Row="2" Classes="toolbar"
                  BorderThickness="1,1,1,0" CornerRadius="0,0,6,6" Padding="12,0"
                  IsEnabled="{Binding HasInput}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10" VerticalAlignment="Center">
              <Button Grid.Column="0" Classes="icon" Command="{Binding PreviousPointCommand}"
                      ToolTip.Tip="Previous representative point">
                <PathIcon Data="{DynamicResource Icon.Previous}" Width="12" Height="12"/>
              </Button>
              <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{StaticResource Brush.Accent}"
                       VerticalAlignment="Center" ToolTip.Tip="Current position"/>
              <Slider x:Name="PreviewSlider" Grid.Column="2" Classes="transport" Minimum="0"
                      Maximum="{Binding DurationSeconds}" Value="{Binding PreviewScrubTime}"
                      ValueChanged="OnPreviewSliderValueChanged"/>
              <Button Grid.Column="3" Classes="icon" Command="{Binding NextPointCommand}"
                      ToolTip.Tip="Next representative point">
                <PathIcon Data="{DynamicResource Icon.Next}" Width="12" Height="12"/>
              </Button>
              <TextBlock Grid.Column="4" x:Name="PreviewTimecode" Classes="timecode"
                         Text="{Binding TimeText}"
                         VerticalAlignment="Center" MinWidth="100" TextAlignment="Right"/>
            </Grid>
          </Border>

        </Grid>
      </Grid>

      <!-- Diagnostics splitter (hidden in compact mode) -->
      <GridSplitter x:Name="DiagnosticsSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                    Background="{StaticResource Brush.Canvas}"/>

      <!-- Right: diagnostics rail (300px in wide mode, hidden in compact) -->
      <Border x:Name="DiagnosticsColumn" Grid.Column="4" Margin="0,12,0,12"
              BorderBrush="{StaticResource Brush.BorderSoft}" BorderThickness="1" CornerRadius="6"
              ClipToBounds="True">
        <local:DiagnosticsPanel x:Name="DiagnosticsPanel"/>
      </Border>
    </Grid>

    <!-- ── Bottom status: error + status ───────────────────────────── -->
    <Border x:Name="StatusBar" Grid.Row="3" Classes="status" Padding="12,5">
      <Grid ColumnDefinitions="*,Auto,2*" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"/>

        <Border Grid.Column="1" IsVisible="{Binding HasError}" Background="{StaticResource Brush.ErrorSurface}"
                BorderBrush="{StaticResource Brush.Error}" BorderThickness="1" CornerRadius="4" Padding="10,4">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       VerticalAlignment="Center" FontSize="11" MaxWidth="360"
                       Foreground="{StaticResource Brush.Error}"/>
            <Button Grid.Column="1" Classes="secondary" Content="Copy details"
                    Command="{Binding CopyErrorCommand}" VerticalAlignment="Center" FontSize="11"/>
          </Grid>
        </Border>

        <TextBlock Grid.Column="2" Classes="metric" Text="{Binding RenderSpecText}"
                   VerticalAlignment="Center" TextAlignment="Right"/>
      </Grid>
    </Border>

    <!-- ── Validation issues (why Render may be disabled) ────────────── -->
    <Border Grid.Row="4" IsVisible="{Binding HasValidationIssues}" Classes="status" Padding="12,5">
      <ItemsControl ItemsSource="{Binding ValidationIssues}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="contracts:ValidationIssue">
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
              <TextBlock Text="{Binding Severity}" FontSize="11"
                         Classes="secondary"/>
              <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

  </Grid>
</Window>
