<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Fmp.Gui</RootNamespace>
    <AssemblyName>mdplayer-visualizer</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Allow running on machines with only a newer .NET runtime (e.g. .NET 10). -->
    <RollForward>LatestMajor</RollForward>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MDPlayer.Fmp.Gui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <!-- Keep this package in every restore graph: a Release restore can be
         reused by a Debug build without restore, which still compiles the
         #if DEBUG AttachDevTools call. The call itself remains Debug-only. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-process preview resolves FMP.COM from the GUI base directory. -->
    <None Include="..\MDPlayer.Fmp.Cli\FMP.COM">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MDPlayer.Fmp.Application\MDPlayer.Fmp.Application.csproj" />
    <!-- The in-process preview session factory now lives in the application
         assembly (Fmp.Cli namespace) so the GUI does not reference the CLI
         parser assembly (architecture: no GUI<->CLI coupling). -->
  </ItemGroup>

</Project>
