<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Allow running on machines with only a newer .NET runtime (e.g. .NET 10). -->
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MDPlayer.Fmp.Core\MDPlayer.Fmp.Core.csproj" />
    <ProjectReference Include="..\..\src\MDPlayer.Fmp.Cli\MDPlayer.Fmp.Cli.csproj" />
    <ProjectReference Include="..\..\src\MDPlayer.Fmp.Application\MDPlayer.Fmp.Application.csproj" />
    <ProjectReference Include="..\..\benchmarks\MDPlayer.Fmp.Benchmarks\MDPlayer.Fmp.Benchmarks.csproj" />
    <ProjectReference Include="..\..\src\MDPlayer.Fmp.Gui\MDPlayer.Fmp.Gui.csproj" />
    <Reference Include="MDSound">
      <HintPath>..\..\lib\MDSound.dll</HintPath>
    </Reference>
    <Content Include="..\Corpus\synthetic\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\Corpus\midi\adversarial-manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\midi\adversarial-manifest.json</Link>
    </Content>
    <!-- A real tracked repo fixture for the in-process preview smoke test. -->
    <Content Include="..\..\..\21 Master Ninja.vgz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\master-ninja.vgz</Link>
    </Content>
    <!-- Real SNES SPC used by the endpoint-canonicalization Smash Up acceptance
         (FR-8): adversarial note-boundary handoff corpus member. -->
    <Content Include="..\..\..\120 Smash Up.spc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\smash-up.spc</Link>
    </Content>
    <!-- Corpus regression fixtures and MIDI adversarial sidecar members. 12 - Ken's
         Theme.vgz is MISSING from the repo (documented exclusion, D18). -->
    <Content Include="..\..\..\02 Stranger ~ Wandering Swordsman.vgz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\corpus\02-stranger.vgz</Link>
    </Content>
    <Content Include="..\..\..\05 - Twilight Express.vgz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\corpus\05-twilight.vgz</Link>
    </Content>
    <Content Include="..\..\..\18 U.S.A. (Ken) I.vgz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\corpus\18-usa-ken.vgz</Link>
    </Content>
    <Content Include="..\..\..\20 Ninja Yashiki ~ Their Secrets Die With Them.vgz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\corpus\20-ninja-yashiki.vgz</Link>
    </Content>
    <Content Include="..\..\..\28 - Smoking Head.vgz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\corpus\28-smoking-head.vgz</Link>
    </Content>
    <Content Include="..\..\..\32 Arctic Wind.vgz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\corpus\32-arctic-wind.vgz</Link>
    </Content>
    <!-- INV1/INV4/INV5 fixture (Gradius II - 53 Triumphal Arch): AY8910 noise
         rhythm edge/retrigger, SCC multi-byte frequency settle, and ultrasonic
         period suppression on both chips. -->
    <Content Include="..\..\..\53 Triumphal Arch.vgz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\53-triumphal-arch.vgz</Link>
    </Content>
    <!-- Real YM2612-DAC-heavy VGZ used by the DAC sample integration tests. -->
    <Content Include="..\..\..\26 - Robotnik.vgz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\robotnik-dac.vgz</Link>
    </Content>
    <!-- Furnace TFI golden fixture (42-byte known-good instrument). -->
    <Content Include="PlaybackAssets\golden_instrument.tfi">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>PlaybackAssets\golden_instrument.tfi</Link>
    </Content>
    <!-- Native-audio validation corpus manifest (Prompt 9R). -->
    <Content Include="..\fixtures\fmp-native-audio-validation.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>fmp-native-audio-validation.json</Link>
    </Content>

    <!-- SPC / OPNA native backends (libmdplayer_spc.so / libmdplayer_opna.so) for
         the native-audio integration tests. These are built by the native CMake
         builds into runtimes/<rid>/native/ (gitignored) and are only present when
         the native build has run. Mirror the CLI packaging so SpcNativeSession /
         OpnaNativeSession resolve them under AppContext.BaseDirectory. -->
    <None Include="..\..\runtimes\linux-x64\native\libmdplayer_spc.so"
          Condition="Exists('..\..\runtimes\linux-x64\native\libmdplayer_spc.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes/linux-x64/native/libmdplayer_spc.so</Link>
    </None>
    <None Include="..\..\runtimes\linux-x64\native\libmdplayer_opna.so"
          Condition="Exists('..\..\runtimes\linux-x64\native\libmdplayer_opna.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes/linux-x64/native/libmdplayer_opna.so</Link>
    </None>
  </ItemGroup>

</Project>
