<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Allow running on machines with only a newer .NET runtime (e.g. .NET 10). -->
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MDPlayer.Fmp.Core\MDPlayer.Fmp.Core.csproj" />
    <ProjectReference Include="..\..\src\MDPlayer.Fmp.Cli\MDPlayer.Fmp.Cli.csproj" />
    <ProjectReference Include="..\..\src\MDPlayer.Fmp.Application\MDPlayer.Fmp.Application.csproj" />
    <ProjectReference Include="..\..\src\MDPlayer.Fmp.Gui\MDPlayer.Fmp.Gui.csproj" />
    <Reference Include="MDSound">
      <HintPath>..\..\lib\MDSound.dll</HintPath>
    </Reference>
    <Content Include="..\Corpus\synthetic\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <!-- A real tracked repo fixture for the in-process preview smoke test. -->
    <Content Include="..\..\..\21 Master Ninja.vgz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>testfixtures\master-ninja.vgz</Link>
    </Content>
  </ItemGroup>

</Project>
