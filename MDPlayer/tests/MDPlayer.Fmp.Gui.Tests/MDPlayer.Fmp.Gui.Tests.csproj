<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Allow running on machines with only a newer .NET runtime (e.g. .NET 10). -->
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Must float with the GUI's Avalonia (11.3.*) so the headless window
         implementation matches the runtime version; a pinned older Headless
         breaks against a newer Avalonia (TypeLoadException / SetHitTestVisible). -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MDPlayer.Fmp.Gui\MDPlayer.Fmp.Gui.csproj" />
  </ItemGroup>

</Project>
