#!/usr/bin/env bash
set -euo pipefail

# Compatibility wrapper for the transitional executable name.
if command -v mdplayer-render >/dev/null 2>&1; then
    exec mdplayer-render "$@"
fi

root="$(cd "$(dirname "$0")" && pwd)"
for configuration in Release Debug; do
    candidate="$root/MDPlayer/src/MDPlayer.Fmp.Cli/bin/$configuration/net8.0/mdplayer-render.dll"
    if [[ -f "$candidate" ]]; then
        exec dotnet "$candidate" "$@"
    fi
done

exec dotnet run --project "$root/MDPlayer/src/MDPlayer.Fmp.Cli/MDPlayer.Fmp.Cli.csproj" -- "$@"
